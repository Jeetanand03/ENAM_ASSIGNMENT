# Copy to backend/.env (local) or add in Vercel -> finn-api -> Settings -> Environment Variables.
# All optional: with no keys the app runs on rules + cached snapshots.
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Paid (strong model for verdicts / bull-bear)
ANTHROPIC_API_KEY=
# Free tier: https://app.tavily.com (management-change bios)
TAVILY_API_KEY=
# Frontend: where the API lives (set in Vercel too)
NEXT_PUBLIC_API_URL=http://localhost:8000
